# URL publica que YA apunta a este servidor/tunel. Sin / al final.
APP_ORIGIN=https://conlact.tu-dominio.example
WHATSAPP_NUMBER=593999999999

# 3079 es la entrada HTTP del proyecto; 3000/8080/5432 son solo internos.
FRONT_PORT=3079
BIND_IP=0.0.0.0

# Base NUEVA local del backend. No apunta a la BD remota de Supabase.
POSTGRES_DB=conlact
POSTGRES_USER=conlact
POSTGRES_PASSWORD='CAMBIAR_PASSWORD_POSTGRES_LARGO'

# Proyecto Supabase del equipo, usado por JWT/Storage de Java.
# No se utiliza como identidad de las cuentas SQLite de Next.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY='CAMBIAR_ANON_KEY'
SUPABASE_SERVICE_ROLE_KEY='CAMBIAR_SERVICE_ROLE_KEY_ROTADA'
# Clave publica valida PEM en una linea/Base64; vacia usa JWKS del proyecto.
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_JWT_SECRET=
STORAGE_PRODUCT_BUCKET=product-images
STORAGE_RECIPE_BUCKET=recipe-images
STORAGE_PAYMENT_BUCKET=payment-proofs

# SMTP compartido por Next (cuentas SQLite) y Java (avisos operativos).
# Usar credenciales NUEVAS. No reutilizar las publicadas en chats/codigo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=correo-emisor@example.com
SMTP_PASSWORD='CAMBIAR_PASSWORD_APLICACION_ROTADA'
SMTP_FROM=CONLAC-T <correo-emisor@example.com>
MAIL_ENABLED=true
MAIL_FROM=correo-emisor@example.com
MAIL_FROM_NAME=CONLAC-T
MAIL_ADMIN_RECIPIENT=correo-operacion@example.com
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false

# Solo se aplican si aun no hay cuentas en SQLite; usar correo accesible real.
INITIAL_ADMIN_EMAIL=correo-admin@example.com
INITIAL_ADMIN_PASSWORD='CAMBIAR_ClaveInicial1_Larga'
