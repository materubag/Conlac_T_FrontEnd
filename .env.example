
# Identidad y Configuración Pública
NEXT_PUBLIC_APP_NAME=CONLAC-T
NEXT_PUBLIC_APP_DESCRIPTION="Consorcio de Lácteos de Tungurahua - Quesos artesanales de Pilahuín"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp para contacto y pedidos asistidos (Formato internacional sin signos +, ej: 593987654321)
NEXT_PUBLIC_WHATSAPP_NUMBER=593999999999
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hola CONLAC-T, deseo información sobre los productos lácteos artesanales de Pilahuín."

# Conexión al Backend API (Spring Boot en Docker)
BACKEND_API_URL=http://localhost:8080/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Datos oficiales de transferencia (completar antes de publicar)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_TYPE=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_BENEFICIARY=
NEXT_PUBLIC_BANK_RUC=
NEXT_PUBLIC_BANK_EMAIL=

# Registro de clientes vía Supabase Auth (el login administrativo usa el backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
