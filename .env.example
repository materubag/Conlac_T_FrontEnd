# ============================================================
# CONLAC-T - Variables de Entorno (Plantilla)
# Consorcio de Lácteos de Tungurahua
# ============================================================

# IMPORTANTE:
# Solo las variables necesarias en el navegador deben tener el prefijo NEXT_PUBLIC_.
# NUNCA agregues secretos, passwords o llaves privadas con NEXT_PUBLIC_.
# Copia este archivo a .env.local para desarrollo local: cp .env.example .env.local

# Identidad y Configuración Pública
NEXT_PUBLIC_APP_NAME=CONLAC-T
NEXT_PUBLIC_APP_DESCRIPTION="Consorcio de Lácteos de Tungurahua - Quesos artesanales de Pilahuín"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp para contacto y pedidos asistidos (Formato internacional sin signos +, ej: 593987654321)
NEXT_PUBLIC_WHATSAPP_NUMBER=593999999999
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hola CONLAC-T, deseo información sobre los productos lácteos artesanales de Pilahuín."

# URLs de servicios futuros (Semana 7+)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
